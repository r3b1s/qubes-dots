#!/bin/sh
# x11-webapp <url>
#
# Open a URL as an app-mode window (omarchy-launch-webapp replacement) when a
# chromium-family browser is available, otherwise fall back to xdg-open.
set -eu

url="$1"

for b in brave-origin-beta brave chromium chromium-browser google-chrome-stable google-chrome; do
    if command -v "$b" >/dev/null 2>&1; then
        exec "$b" --app="$url"
    fi
done

exec xdg-open "$url"
