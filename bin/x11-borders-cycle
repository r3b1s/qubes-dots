#!/bin/sh
# Cycle window border width, mirroring the hyprland borders cycle.
#
# i3 can't change default_border at runtime, so this applies to all current
# windows; new windows keep the width configured in the i3 config.
set -eu

STATE="${XDG_RUNTIME_DIR:-/tmp}/x11-borders-cycle.idx"
presets="16 8 6 4 3 2 1 0"

count=$(set -- $presets; echo $#)
idx=$(cat "$STATE" 2>/dev/null || echo 0)
idx=$(( idx % count + 1 ))
px=$(echo "$presets" | cut -d' ' -f"$idx")

i3-msg "[class=\".*\"] border pixel $px" >/dev/null
echo "$idx" > "$STATE"
dunstify -a x11-dots -r 9995 "Window borders: ${px}px"
