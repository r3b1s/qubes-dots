# x11-dots dunst config — Dracula theme colours.
# Per-urgency colours from the official Dracula dunst theme.

[global]
    follow = keyboard
    origin = top-right
    offset = 12x40
    notification_limit = 6
    frame_width = 2
    gap_size = 4
    font = Monospace 11
    format = "<b>%s</b>\n%b"
    show_indicators = yes

    frame_color = "#bd93f9"
    separator_color = frame

    # Action/context menus go through the shared x11-dmenu wrapper.
    dmenu = x11-dmenu -p dunst:
    browser = xdg-open

    mouse_left_click = do_action, close_current
    mouse_middle_click = context
    mouse_right_click = close_current

[urgency_low]
    background = "#282a36"
    foreground = "#6272a4"
    timeout = 5

[urgency_normal]
    background = "#282a36"
    foreground = "#f8f8f2"
    timeout = 8

[urgency_critical]
    background = "#ff5555"
    foreground = "#f8f8f2"
    frame_color = "#ff5555"
    timeout = 0
