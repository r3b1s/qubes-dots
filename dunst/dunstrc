# x11-dots dunst config (mako replacement) — functionality over rice.
# Colors fall back to dunst's per-urgency defaults on purpose.

[global]
    follow = keyboard
    origin = top-right
    offset = 12x40
    notification_limit = 6
    frame_width = 2
    gap_size = 4
    font = Monospace 11
    format = "<b>%s</b>\n%b"
    show_indicators = yes

    # Action/context menus go through vanilla dmenu.
    dmenu = dmenu -i -p dunst:
    browser = xdg-open

    mouse_left_click = do_action, close_current
    mouse_middle_click = context
    mouse_right_click = close_current

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
