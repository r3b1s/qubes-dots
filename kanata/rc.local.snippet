# === kanata (qubes-dots) ===
# Install payload from persistent /rw into disposable root each boot.
KANATA_RW=/rw/home/user/kanata

cp "$KANATA_RW/launch-input-sender.py" /usr/local/bin/
chmod +x /usr/local/bin/launch-input-sender.py

mkdir -p /etc/systemd/system/qubes-input-sender-keyboard@.service.d/
cp "$KANATA_RW/kanata-exclusions.conf" \
  /etc/systemd/system/qubes-input-sender-keyboard@.service.d/kanata-exclusions.conf

cp "$KANATA_RW/kanata" /usr/local/bin/kanata
chmod +x /usr/local/bin/kanata

cp "$KANATA_RW/kanata.service" /etc/systemd/system/kanata.service

systemctl daemon-reload
systemctl restart 'qubes-input-sender-keyboard@*' || true
systemctl enable kanata
systemctl start kanata
# === end kanata (qubes-dots) ===
