# qubes-dots i3 config — entry point, for dom0 on Qubes OS.
# Migrated from the hyprland setup in omarchy-overrides; see README.md for
# the full mapping and the list of intentionally dropped binds.
#
# Variables must be defined before the includes so every module can use them.
#
# conf.d/ loads in glob order, and that order is load-bearing:
#   00-qubes-base.conf   the vendored Qubes defaults (colours, bar, autostart)
#   10-…-70-…            our layer, which overrides base scalars (last wins)
# i3 resolves duplicate `bindsym` and `bar` as FIRST wins and has no
# `unbindsym`, so our modules never redeclare anything base already binds.

# ── variables ─────────────────────────────────────────────────────────────

set $mod Mod4
set $bin ~/.local/bin

# The terminal is $terminal, from 00-qubes-base.conf: it opens in the domain of
# the focused window rather than in a dom0 shell. $dom0_term (10-core.conf) is
# the plain dom0 terminal, for the binds that must pass `-e <cmd>`.

# ── modules ───────────────────────────────────────────────────────────────

include conf.d/*.conf
